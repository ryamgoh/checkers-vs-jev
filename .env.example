# Copy to .env for local runs (never commit .env). The hosted app gets these from Manus secrets.
# Required for Jev. Server-side only; never sent to the browser.
OPENROUTER_API_KEY=
# Optional
JEV_MODEL=typesafe/jev-1.14
JEV_TIMEOUT_MS=5000
JEV_MAX_CALLS_PER_DAY=2000
ENGINE_BUDGET_MS=1500
GAME_TTL_MS=7200000
PORT=3000
